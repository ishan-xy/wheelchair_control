# Copy this file to .env and replace every example value.
# Use a unique passkey for each wheelchair.
VAYA_BLE_PASSKEY=483921

# Keep false until the physical Pair / Wake button is installed and tested.
VAYA_FEATURE_PAIRING_BUTTON=false
# Set only when VAYA_FEATURE_PAIRING_BUTTON=true. The button is wired to GND.
VAYA_PAIR_WAKE_BUTTON_PIN=-1

# Disabled until the respective hardware is wired and tested.
VAYA_FEATURE_AUTO_STANDBY=false
VAYA_FEATURE_SOS_BUTTON=false
VAYA_SOS_BUTTON_PIN=-1
VAYA_FEATURE_ALERT_INDICATOR=false
VAYA_ALERT_INDICATOR_PIN=-1
VAYA_FEATURE_CHARGER_DETECTION=false
VAYA_CHARGER_DETECT_PIN=-1

# macOS example. Windows commonly uses COM3; Linux commonly uses /dev/ttyUSB0.
VAYA_UPLOAD_PORT=/dev/cu.usbserial-0001
